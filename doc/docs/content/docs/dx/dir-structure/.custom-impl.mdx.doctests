    mtime: SystemTime,
    value: T,
}

// !collapse(1:9) collapsed
impl<T: ReadFrom> ReadFrom for FsMtime<T> {
    fn read_from(path: &Path) -> Result<Self> {
        let mtime =
            path.metadata().wrap_io_error_with(path)?
                .modified().wrap_io_error_with(path)?;
        let value = T::read_from(path)?;
        Ok(FsMtime { mtime, value })
    }
}

// !mark(1:6)
impl<T: WriteTo> WriteTo for FsMtime<T> {
    fn write_to(&self, path: &Path) -> Result<()> {
        todo!();
        Ok(())
    }
}
```

## !!steps Write the value

We first need to write the inner value to the path.

```rust,no_run
use std::path::Path;
use std::time::SystemTime;

use dir_structure::{DirStructure, DirStructureItem, ReadFrom, Result, WrapIoError, WriteTo};

// !collapse(1:4) collapsed
struct FsMtime<T> {
    mtime: SystemTime,
    value: T,
}

// !collapse(1:9) collapsed
impl<T: ReadFrom> ReadFrom for FsMtime<T> {
    fn read_from(path: &Path) -> Result<Self> {
        let mtime =
            path.metadata().wrap_io_error_with(path)?
                .modified().wrap_io_error_with(path)?;
        let value = T::read_from(path)?;
        Ok(FsMtime { mtime, value })
    }
}

impl<T: WriteTo> WriteTo for FsMtime<T> {
    fn write_to(&self, path: &Path) -> Result<()> {
        // !mark
        self.value.write_to(path)?;
        todo!();
        Ok(())
    }
}
```


## !!steps Write the mtime

```rust,no_run
use std::path::Path;
use std::time::SystemTime;

use dir_structure::{DirStructure, DirStructureItem, ReadFrom, Result, WrapIoError, WriteTo};

// !collapse(1:4) collapsed
struct FsMtime<T> {
    mtime: SystemTime,
    value: T,
}

// !collapse(1:9) collapsed
impl<T: ReadFrom> ReadFrom for FsMtime<T> {
    fn read_from(path: &Path) -> Result<Self> {
        let mtime =
            path.metadata().wrap_io_error_with(path)?
                .modified().wrap_io_error_with(path)?;
        let value = T::read_from(path)?;
        Ok(FsMtime { mtime, value })
    }
}

// !collapse(1:10)
impl<T: WriteTo> WriteTo for FsMtime<T> {
    fn write_to(&self, path: &Path) -> Result<()> {
        self.value.write_to(path)?;
        // !mark(1:4)
        std::fs::File::open(path)
            .wrap_io_error_with(path)?
            .set_modified(self.mtime)
            .wrap_io_error_with(path)?;
        Ok(())
    }
}
```

## !!steps End

And that's it! We have implemented a new wrapper type that allows us to read and write the modification time of files.

```rust,no_run
use std::path::Path;
use std::time::SystemTime;

use dir_structure::{DirStructure, DirStructureItem, ReadFrom, Result, WrapIoError, WriteTo};

// !collapse(1:4)
struct FsMtime<T> {
    mtime: SystemTime,
    value: T,
}

// !collapse(1:9)
impl<T: ReadFrom> ReadFrom for FsMtime<T> {
    fn read_from(path: &Path) -> Result<Self> {
        let mtime =
            path.metadata().wrap_io_error_with(path)?
                .modified().wrap_io_error_with(path)?;
        let value = T::read_from(path)?;
        Ok(FsMtime { mtime, value })
    }
}

// !collapse(1:10)
impl<T: WriteTo> WriteTo for FsMtime<T> {
    fn write_to(&self, path: &Path) -> Result<()> {
        self.value.write_to(path)?;
        std::fs::File::open(path)
            .wrap_io_error_with(path)?
            .set_modified(self.mtime)
            .wrap_io_error_with(path)?;
        Ok(())
    }
}
```

